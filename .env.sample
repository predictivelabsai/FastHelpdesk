# --- FastHelpdesk ----------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

FASTHELPDESK_ADMIN_EMAIL=admin@fasthelpdesk.example
FASTHELPDESK_ADMIN_PASSWORD=FastHelpdesk2026$
FASTHELPDESK_SECRET=
FASTHELPDESK_PORT=5007
FASTHELPDESK_ENV_LABEL=FastHelpdesk
# Blank => ./fasthelpdesk.sqlite. In Docker point at the mounted volume.
FASTHELPDESK_DB=

# --- AI assistant ----------------------------------------------------------
# Free-form chat uses one provider; slash-commands (/sla, /tickets …) need no key.
#   MODEL_PROVIDER: xai | openai | anthropic | google
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://helpdesk.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://helpdesk.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
